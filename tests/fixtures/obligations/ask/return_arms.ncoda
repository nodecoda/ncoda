@language nodecoda/1
@mode workflow
// @p5 construct=ask a=A1/A2/A8 edge=branch-port expect=equivalent
// Carrier-only note: the arm terminal is return in the source and flow after
// decompilation; the ordered value closure is identical.
enum ReviewAction { approve, reject }
type ReviewForm = { string comment; }
function main() -> string {
    ask<ReviewForm, ReviewAction>({
        content: "Review",
        fields: { comment: { kind: "paragraph" } },
        actions: {
            approve: { title: "Approve", style: "primary" },
            reject: { title: "Reject", style: "default" }
        },
        timeout: { value: 3, unit: "day" }
    }) as review {
        action ReviewAction.approve { return review.comment; }
        action ReviewAction.reject { return "rejected"; }
        timeout { return "timed out"; }
    }
}
