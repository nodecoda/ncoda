@language nodecoda/1
@mode workflow
// @p5 construct=switch a=A1/A2 edge=branch-port expect=equivalent
// P5: both switch arms are empty; the continuation is outside every arm.
function main(string kind) -> string {
    string out;
    out = "base";
    switch (kind) {
        "a": { }
        default: { }
    }
    return out;
}
