@language nodecoda/1
@mode workflow
// @p5 construct=switch a=A1/A2/A4 edge=branch-port expect=equivalent
// P5: an if inside a switch arm keeps its own merge and does not leak ports.
function main(string kind, string sub) -> string {
    string out;
    out = "base";
    switch (kind) {
        "a": {
            if (sub == "x") {
                out = "ax";
            } else {
                out = "a";
            }
        }
        default: { out = "?"; }
    }
    return out;
}
