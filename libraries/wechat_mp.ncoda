// wechat_mp.ncoda — capability header (provider = file name)
// desc: 微信公众号API

@language nodecoda/1
library wechat_mp @ 0.1.0;

type WechatMpAddDraftResult = {
  int errcode;

  string errmsg;

  string media_id;
};
type WechatMpAddMaterialResult = {
  string errmsg;

  string media_id;

  string url;
};
type WechatMpGetAccessTokenResult = {
  string access_token;

  string errmsg;

  string msg;
};
type WechatMpPublishArticleResult = {
  string errcode;

  string errmsg;

  string publish_id;
};

function add_draft(string access_token = 0, string content = 0, string thumb_media_id = 0, string title = 0, string author = 0, string content_source_url = 0, string digest = 0, bool only_fans_can_comment = 0, bool need_open_comment = 0, any pic_crop_1_1 = 0, any pic_crop_235_1 = 0, any channel = 0) -> WechatMpAddDraftResult {}
function add_material(string access_token = 0, string image_url = 0, any channel = 0) -> WechatMpAddMaterialResult {}
function get_access_token(string appid = 0, string appsecret = 0, string grant_type = 0, any channel = 0, any aigc_key = 0) -> WechatMpGetAccessTokenResult {}
function publish_article(string access_token = 0, string media_id = 0, string channel = 0) -> WechatMpPublishArticleResult {}
