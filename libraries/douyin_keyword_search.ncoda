// douyin_keyword_search.ncoda — capability header (provider = file name)
// desc: 抖音关键词检索

@language nodecoda/1
library douyin_keyword_search @ 0.1.0;

type DouyinKeywordSearchDouyinKeywordResult = {
  string note;

  array<DouyinKeywordSearchDouyinKeywordResultValue> result;
};
type DouyinKeywordSearchDouyinKeywordResultValue = {
  string author;

  float comment_count;

  string cover_url;

  string create_time;

  string desc;

  float like_count;

  string play_url;

  float share_count;

  string share_url;

  string video_id;
};

function douyin_keyword(string api_key = 0, string cookie = 0, string keyword = 0, int publish_time = 0, int sort_type = 0, string search_id = 0) -> DouyinKeywordSearchDouyinKeywordResult {}
