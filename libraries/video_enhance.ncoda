@language nodecoda/1
library video_enhance @ 0.1.0;

type VideoEnhanceVideoClearerResult = {
  VideoEnhanceVideoClearerData data;

  string message;
};
type VideoEnhanceVideoClearerData = {
  string id;
};

@capability failure_branch=true, timeout_ms=180000
function video_clearer(string key = 0, string video_url = 0) -> VideoEnhanceVideoClearerResult {}

type VideoEnhanceRTaskInfoResult = {
  VideoEnhanceRTaskInfoData data;

  string message;

  int status;
};
type VideoEnhanceRTaskInfoData = {
  string url;
};

@capability failure_branch=true, timeout_ms=180000
function r_task_info(string id = 0) -> VideoEnhanceRTaskInfoResult {}
