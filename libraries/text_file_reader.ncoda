// text_file_reader.ncoda — capability header (library = file name)
// desc: 读取文本内容

@language nodecoda/1
library text_file_reader @ 0.1.0;

type ReadTxtResult = {
  string message;

  string text;
};

@capability failure_branch=true, timeout_ms=180000
function read_txt(string txt_url = 0) -> ReadTxtResult {}
