@language nodecoda/1
library kimi_chat_parser @ 0.1.0;

type KimiChatParserChunksItem = {
  string answer;
  string question;
};

type KimiChatParserResult = {
  array<string> answers;
  array<KimiChatParserChunksItem> chunks;
  array<string> questions;
};

function kimi_chat_parser(any kimi_chathistory = 0) -> KimiChatParserResult {}
