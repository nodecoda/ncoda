  string first_image;

  string prompt;

  int status;

  string task_id;

  string updated_at;

  string video_url;
};

function img2_video(string api_token = 0, string img_url = 0, any model = 0, any prompt = 0, bool camerafixed = 0, int duration = 0, string end_image_url = 0, bool asyn = 0, string resolution = 0) -> JimengImg2videoImg2VideoResult {}
function task_info(string task_id = 0, int wait_cnt = 0) -> JimengImg2videoTaskInfoResult {}
