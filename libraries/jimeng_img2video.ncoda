@language nodecoda/1
library jimeng_img2video @ 0.1.0;

type JimengImg2videoImg2VideoResult = {
  JimengImg2videoImg2VideoData data;

  string msg;

  array<JimengImg2videoImg2VideoOutputlist> outputList;

  int $code;

  string tip_url;
};
type JimengImg2videoImg2VideoData = {
  string created_at;

  string first_image;

  string model;

  string prompt;

  int status;

  string task_id;

  string updated_at;
};
type JimengImg2videoImg2VideoOutputlist = {
