// datetime.ncoda — capability header (provider = file name)
// desc: 日期时间

@language nodecoda/1
library datetime @ 0.1.0;

type DatetimeDatetimeResult = {
  float date;

  string dateOnly;

  string dateTime;

  string filenameFriendly;

  float hour;

  float millisecond;

  float minute;

  float month;

  string prompt;

  float second;

  string timeOnly;

  int timestamp;

  float year;
};

function datetime(string datetime = 0) -> DatetimeDatetimeResult {}
