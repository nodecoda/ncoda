// av_toolkit.ncoda — capability header (library = file name)
// desc: 音视频工具集合

@language nodecoda/1
library av_toolkit @ 0.1.0;

type AudioSplitResult = {
  AudioSplitData data;

  string msg;

  float $code;
};
type AudioSplitData = {
  float duration;

  string url;
};

@capability failure_branch=true, timeout_ms=180000
function audio_split(string audio_url = 0, int end_time = 0, int start_time = 0) -> AudioSplitResult {}
