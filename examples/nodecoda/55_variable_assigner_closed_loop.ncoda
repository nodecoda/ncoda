@language nodecoda/1
// 55_variable_assigner_closed_loop.ncoda
// 闭环验证: advanced-chat + literal set + append with node ref

@mode advanced-chat

@conversation string greeting = "hello";
@conversation array<string> history = [];

function main(string query) {
    // set 操作：字面量值 ✅
    greeting = "welcome";
    
    // append 操作：引用节点输出 ✅
    history << query;
    
    output(greeting);
}
