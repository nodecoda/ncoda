@language nodecoda/1
// 30_workflow_llm.ncoda
// Dify YAML: examples/dify/workflow_llm.yml
//
// Flow: Start(question) → LLM(gpt-4o) → End(answer)
// Pattern: Workflow mode LLM with question input

@mode workflow

const MODEL = "openai_api_compatible/gpt-5.4";

function main(string question) {
    let response = llm(MODEL, {
        "messages": [
            { "role": "system", "content": "" },
            { "role": "user",   "content": question }
        ],
        "temperature": 0.7
    });

    return response.text;
}
