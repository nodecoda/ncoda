@mode workflow

function main(string x, int num, string select, string text) {
    let result = foreign code python3(
        string x = x,
        int num = num,
        string select = select,
        string text = text
    ) -> string {
        source `def main(x: str, num: int, select: str, text: str) -> dict:
    return {"result": f"{x} {num} {select} {text}"}`;
    };

    return result;
}
