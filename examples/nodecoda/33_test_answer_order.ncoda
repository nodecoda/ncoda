@language nodecoda/1
// 33_test_answer_order.ncoda
// Dify YAML: examples/yaml/test-answer-order.yml
//
// Flow: Start → LLM → Answer1("--- answer 1 ---\nfoo\n") → Answer2(LLM text)
// Pattern: advanced-chat with chained answer nodes

@mode advanced-chat

const MODEL = "openai_api_compatible/gpt-5.4";

function main(string query) {
    let response = llm(MODEL, {
        "messages": [
            { "role": "system", "content": "" },
            { "role": "user",   "content": query }
        ],
        "temperature": 0.7
    });

    // First answer
    output("--- answer 1 ---\nfoo\n");

    // Second answer with LLM output
    return `--- answer 2 ---\n${response.text}\n`;
}
