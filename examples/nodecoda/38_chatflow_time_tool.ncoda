@language nodecoda/1
// 38_chatflow_time_tool.ncoda
//
// Flow: Start → CurrentTime(tool) → Template("hello, ncoda!") → Answer
// Pattern: advanced-chat with tool + static template

@mode advanced-chat
import "time";

function main(string query) {
    let now = time.current_time({
        "format": "%Y-%m-%d %H:%M:%S",
        "timezone": "UTC"
    });

    return "hello, ncoda!";
}
