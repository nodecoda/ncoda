@language nodecoda/1
// 01_simple_chat.ncoda
// Dify YAML: examples/yaml/01_simple_chat.yml
//
// Flow: Start(language) → LLM → Answer
//
// Mapping:
//   Start.variables[0]  → input string language
//   LLM.prompt_template  → llm(MODEL, { messages })
//   Answer.answer        → return ...

@mode workflow

const MODEL = "openai_api_compatible/gpt-5.4";

function main(string query, string language = "中文") {
    let response = llm(MODEL, {
        "messages": [
            { "role": "system", "content": `你是一个有用的助手，请用 ${language} 回答。` },
            { "role": "user",   "content": query }
        ],
        "temperature": 0.7,
        "max_tokens": 2048
    });

    return response.text;
}
