@language nodecoda/1
@mode workflow

// 操作策略 with retry:给 LLM 调用加重试配置。
// 覆盖 operation_policy(retry max/interval)与 duration(1s)两条产生式。
const MODEL = "openai_api_compatible/gpt-5.4";

function main(string q) -> string {
    let r = llm(MODEL, {
        "messages": [{ "role": "user", "content": q }]
    }) with retry(max: 2, interval: 1s);
    return r.text;
}