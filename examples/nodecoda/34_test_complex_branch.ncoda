@language nodecoda/1
// 34_test_complex_branch.ncoda
// Dify YAML: examples/yaml/test_complex_branch.yml
//
// Flow: Start → IF(query contains "hello") →
//   true:  Answer("contains 'hello'")
//   false: LLM → Answer(LLM text)
//
// Pattern: advanced-chat with if-else branching

@mode advanced-chat

const MODEL = "openai_api_compatible/gpt-5.4";

function main(string query) {
    if (query.contains("hello")) {
        return "contains 'hello'";
    } else {
        let response = llm(MODEL, {
            "messages": [
                { "role": "system", "content": "" },
                { "role": "user",   "content": query }
            ],
            "temperature": 0.7
        });
        return response.text;
    }
}
