@language nodecoda/1
// 21_iteration_flatten_output.ncoda
// Dify YAML: examples/yaml/iteration_flatten_output_enabled_workflow.yml
//
// Flow: Start → Code(generate [1,2,3]) → Iteration → Code(pair) → End
// Pattern: Iteration with flatten_output=true (flat arrays)
// ForExpr syntax: var x = for (item in items) { ... };  → flatten_output=true

@mode workflow

function main() {
    let data = foreign code python3() -> array<int> {
        source `def main() -> dict:
    return {"result": [1, 2, 3]}`;
    };

    var results = for (item in data) {
        let pair = foreign code python3(
            int arg1 = item
        ) -> array<int> {
            source `def main(arg1: int) -> dict:
    return {"result": [arg1, arg1 * 2]}`;
        };
        yield pair;
    };

    return results;
}
