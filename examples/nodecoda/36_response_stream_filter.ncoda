@language nodecoda/1
// 36_response_stream_filter.ncoda
// Dify YAML: examples/yaml/response_stream_filter_issue_170_workflow.yml
//
// Flow: Start → LLM1(Li Bai poem) → LLM2(Du Fu poem) → Answer(combined)
// Pattern: advanced-chat with sequential LLM chain

@mode advanced-chat

const FAST_MODEL = "openai_api_compatible/gpt-5.4";

function main(string query) {
    let libai = llm(FAST_MODEL, {
        "messages": [
            { "role": "system", "content": "Please output a poem by Li Bai" },
            { "role": "user",   "content": query }
        ],
        "temperature": 0.7
    });

    let dufu = llm(FAST_MODEL, {
        "messages": [
            { "role": "system", "content": "Please output a poem by Du Fu" },
            { "role": "user",   "content": query }
        ],
        "temperature": 0.7
    });

    return `# Du Fu\n\n${dufu.text}\n\n# Li Bai\n\n${libai.text}`;
}
